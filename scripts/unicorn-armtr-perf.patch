+#include <nmmintrin.h>
+/* armtr: the SSE4.2 crc32 insn is CRC-32C (bionic's scudo checksums every chunk header with crc32cx). */
+__attribute__((target("sse4.2")))
+static uint32_t crc32c_sse42(uint32_t crc, const uint8_t *data, unsigned int length)
+{
+    while (length--) {
+        crc = _mm_crc32_u8(crc, *data++);
+    }
+    return crc ^ 0xffffffff;
+}
+#endif
