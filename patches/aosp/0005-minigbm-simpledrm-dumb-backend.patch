diff --git a/cros_gralloc/cros_gralloc_driver.cc b/cros_gralloc/cros_gralloc_driver.cc
index b17c8c7..ee7fa82 100644
--- a/cros_gralloc/cros_gralloc_driver.cc
+++ b/cros_gralloc/cros_gralloc_driver.cc
@@ -112,6 +112,12 @@ static struct driver *init_try_node(int idx, char const *str)
 	drv = drv_create(fd);
 	if (!drv)
 		close(fd);
+	else
+		/*
+		 * Allocation only: never keep DRM master on a card node, the display server
+		 * (drm_hwcomposer) needs it. Opening a card node first makes us master otherwise.
+		 */
+		drmDropMaster(fd);
 
 	return drv;
 }
